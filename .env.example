# ==============================================================================
# CREDENCIAIS DO INLABS (IMPRENSA NACIONAL)
# ==============================================================================
# O INLABS (inlabs.in.gov.br) e o servico oficial e gratuito da Imprensa Nacional
# para distribuicao de dados abertos do Diario Oficial da Uniao (DOU) em XML.
#
# Para obter seu acesso gratuito:
# 1. Acesse https://inlabs.in.gov.br
# 2. Clique em "Cadastrar" / "Criar Conta"
# 3. Informe seu e-mail e defina uma senha
# 4. Copie este arquivo para .env (cp .env.example .env) e preencha abaixo:
# ==============================================================================

INLABS_EMAIL=seu_email@empresa.com.br
INLABS_PASSWORD=sua_senha_inlabs
